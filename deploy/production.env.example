# Example values only. Set secrets in the host's protected environment settings.
# Do not load .devcontainer/environment.sh in production: it forces DEBUG=1.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
PUBLIC_SITE_URL=https://your-pilot-host.example
DJANGO_ALLOWED_HOSTS=your-pilot-host.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-pilot-host.example
# Must be a persistent private directory outside public static hosting.
DJANGO_DATA_DIR=/srv/together-private
DJANGO_STATIC_ROOT=/srv/together-static
# Set to 1 only when the host's trusted proxy strips/replaces X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Together for Better <replace-with-your-verified-sender@example.org>"
OPENAI_API_KEY=
RESUME_AI_MODEL=gpt-4.1-mini
