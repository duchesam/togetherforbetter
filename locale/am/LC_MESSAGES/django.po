msgstr[1] "እንደገና ከመሞከርዎ በፊት %(minutes)s ደቂቃዎች ይጠብቁ።"

msgid "Account settings"
msgstr "የመለያ ቅንብሮች"

msgid "YOUR ACCOUNT, YOUR CONTROL"
msgstr "መለያዎን እርስዎ ይቆጣጠሩ"

msgid "Preferred language"
msgstr "የሚመርጡት ቋንቋ"

msgid "Email me about applications and status changes"
msgstr "ስለ ማመልከቻዎችና የሁኔታ ለውጦች በኢሜይል አሳውቀኝ"

msgid ""
"Application emails are sent only to a verified email address. In-app "
"notifications remain available when email is turned off."
msgstr "የማመልከቻ ኢሜይሎች ወደ ተረጋገጠ አድራሻ ብቻ ይላካሉ። ኢሜይል ቢዘጋም የመድረኩ ማሳወቂያዎች ይቀጥላሉ።"

msgid "Save preferences"
msgstr "ምርጫዎችን አስቀምጥ"

msgid "Account preferences saved."
msgstr "የመለያ ምርጫዎች ተቀምጠዋል።"

msgid "Email verified"
msgstr "ኢሜይሉ ተረጋግጧል"

msgid ""
"Verify your email to receive application updates and protect your account."
msgstr "የማመልከቻ ዜናዎችን ለመቀበልና መለያዎን ለመጠበቅ ኢሜይልዎን ያረጋግጡ።"

msgid "Email verification is required before you apply or post opportunities."
msgstr "ከማመልከትዎ ወይም ዕድል ከማስተዋወቅዎ በፊት ኢሜይልዎን ማረጋገጥ ያስፈልጋል።"

msgid "Send verification email"
msgstr "የማረጋገጫ ኢሜይል ላክ"

msgid ""
"Your account needs a valid email address. Contact the platform "
"administrator."
msgstr "መለያዎ ትክክለኛ የኢሜይል አድራሻ ያስፈልገዋል። የመድረኩን አስተዳዳሪ ያነጋግሩ።"

msgid "Verification instructions have been queued for your email address."
msgstr "የማረጋገጫ መመሪያዎች ወደ ኢሜይልዎ እንዲላኩ ተዘጋጅተዋል።"

msgid "Your email address is already verified."
msgstr "የኢሜይል አድራሻዎ ከዚህ በፊት ተረጋግጧል።"

msgid "Your email address is verified."
msgstr "የኢሜይል አድራሻዎ ተረጋግጧል።"

msgid "PROTECT YOUR ACCOUNT"
msgstr "መለያዎን ይጠብቁ"

msgid "Confirm your email address."
msgstr "የኢሜይል አድራሻዎን ያረጋግጡ።"

msgid ""
"Confirm that this email belongs to you. Opening this page alone does not "
"verify your account."
msgstr "ይህ ኢሜይል የእርስዎ መሆኑን ያረጋግጡ። ይህን ገጽ መክፈት ብቻ መለያዎን አያረጋግጥም።"

msgid "Verify my email"
msgstr "ኢሜይሌን አረጋግጥ"

msgid "This verification link cannot be used."
msgstr "ይህን የማረጋገጫ አገናኝ መጠቀም አይቻልም።"

msgid ""
"It may have expired, been replaced, or belong to another account. Sign in to"
" the correct account and request a new email."
msgstr ""
"ጊዜው አልፎ፣ በሌላ ተተክቶ ወይም የሌላ መለያ ሊሆን ይችላል። ወደ ትክክለኛው መለያ ይግቡና አዲስ ኢሜይል ይጠይቁ።"

msgid "Verify your email address"
msgstr "የኢሜይል አድራሻዎን ያረጋግጡ"

msgid "Verify your email address before applying."
msgstr "ከማመልከትዎ በፊት የኢሜይል አድራሻዎን ያረጋግጡ።"

msgid "Verify your email address before posting an opportunity."
msgstr "ዕድል ከማስተዋወቅዎ በፊት የኢሜይል አድራሻዎን ያረጋግጡ።"

msgid "Verify your Together for Better email address"
msgstr "የTogether for Better የኢሜይል አድራሻዎን ያረጋግጡ"

msgid ""
"Confirm your email address to finish setting up your Together for Better "
"account."
msgstr "የTogether for Better መለያዎን ለማጠናቀቅ የኢሜይል አድራሻዎን ያረጋግጡ።"

msgid ""
"Sign in to your account and confirm on the verification page. This link "
"expires after 24 hours and can be used once."
msgstr ""
"ወደ መለያዎ ይግቡና በማረጋገጫ ገጹ ላይ ያረጋግጡ። ይህ አገናኝ ከ24 ሰዓታት በኋላ ያበቃል፣ አንድ ጊዜ ብቻ ይሠራል።"

msgid "If you did not create this account, ignore this email."
msgstr "ይህን መለያ እርስዎ ካልፈጠሩ ይህን ኢሜይል ችላ ይበሉት።"

msgid "Notifications"
msgstr "ማሳወቂያዎች"

msgid "STAY CONNECTED"
msgstr "ግንኙነትዎን ይቀጥሉ"

msgid "Your application updates, all in one place."
msgstr "የማመልከቻ ዜናዎችዎ በአንድ ቦታ።"

msgid "Unread"
msgstr "ያልተነበበ"

msgid "View application"
msgstr "ማመልከቻውን ይመልከቱ"

msgid ""
"No notifications yet. Updates will appear here when an application is "
"received or its status changes."
msgstr "ገና ማሳወቂያ የለም። ማመልከቻ ሲደርስ ወይም ሁኔታው ሲቀየር ዜናው እዚህ ይታያል።"

msgid "New application received"
msgstr "አዲስ ማመልከቻ ደርሷል"

msgid "Application status changed"
msgstr "የማመልከቻ ሁኔታ ተቀይሯል"

msgid "An application update on Together for Better"
msgstr "በTogether for Better ላይ የማመልከቻ ዜና"

#, python-format
msgid "A new application has been received for %(title)s."
msgstr "ለ %(title)s አዲስ ማመልከቻ ደርሷል።"

#, python-format
msgid "Your application for %(title)s was updated to: %(status)s."
msgstr "ለ %(title)s ያቀረቡት ማመልከቻ ሁኔታ ወደ %(status)s ተቀይሯል።"

msgid "Sign in to view the latest application details:"
msgstr "የቅርብ ጊዜውን የማመልከቻ ዝርዝር ለማየት ይግቡ፦"

msgid ""
"Manage application emails in your account settings. In-app notifications "
"remain available when email is turned off."
msgstr "የማመልከቻ ኢሜይሎችን ከመለያ ቅንብሮችዎ ይቆጣጠሩ። ኢሜይል ቢዘጋም የመድረኩ ማሳወቂያዎች ይቀጥላሉ።"

msgid "Account closure"
msgstr "መለያ መዝጋት"

msgid "Delete my account"
msgstr "መለያዬን ሰርዝ"

msgid "Delete your account?"
msgstr "መለያዎ ይሰረዝ?"

msgid "PERMANENT ACCOUNT DELETION"
msgstr "ቋሚ የመለያ ስረዛ"

msgid "This action cannot be undone."
msgstr "ይህን እርምጃ መመለስ አይቻልም።"

msgid ""
"You can permanently delete your job seeker account and associated applicant "
"data."
msgstr "የሥራ ፈላጊ መለያዎንና ተያያዥ የአመልካች መረጃዎን በቋሚነት መሰረዝ ይችላሉ።"

msgid ""
"Your profile, CV, applications, notifications, and queued account emails "
"will be removed. You will be signed out."
msgstr ""
"መገለጫዎ፣ ሲቪዎ፣ ማመልከቻዎችዎ፣ ማሳወቂያዎችዎና በመጠባበቅ ላይ ያሉ የመለያ ኢሜይሎች ይሰረዛሉ። ከመለያዎም ይወጣሉ።"

msgid ""
"Safety reports may be retained without your account link. Audit records, "
"backups, and copies already downloaded by employers are subject to separate "
"retention policies and are not recalled by this action."
msgstr ""
"የደኅንነት ሪፖርቶች ከመለያዎ ጋር ሳይገናኙ ሊቀመጡ ይችላሉ። የክትትል መዝገቦች፣ መጠባበቂያ ቅጂዎችና አሠሪዎች ቀድመው "
"ያወረዷቸው ቅጂዎች በተለየ የማቆያ ፖሊሲ ይተዳደራሉ፤ በዚህ እርምጃ አይመለሱም።"

msgid "Current password"
msgstr "አሁን ያለው የይለፍ ቃል"

msgid "I understand that deleting my account is permanent."
msgstr "መለያዬን መሰረዝ ቋሚ መሆኑን ተረድቻለሁ።"

msgid "Your password was incorrect. Your account has not been deleted."
msgstr "የይለፍ ቃልዎ ትክክል አልነበረም። መለያዎ አልተሰረዘም።"

msgid "Permanently delete my account"
msgstr "መለያዬን በቋሚነት ሰርዝ"

msgid "Keep my account"
msgstr "መለያዬን አቆይ"

msgid "Your account and associated applicant data have been deleted."
msgstr "መለያዎና ተያያዥ የአመልካች መረጃዎ ተሰርዘዋል።"

msgid "Organization and staff accounts require administrator-managed closure."
msgstr "የድርጅትና የሠራተኛ መለያዎች በአስተዳዳሪ መዘጋት አለባቸው።"

msgid "Account email delivery"
